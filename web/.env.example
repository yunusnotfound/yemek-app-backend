# ── Sunucu tarafı (yalnız Next sunucusu okur, tarayıcıya sızmaz) ───────────────
# Next BFF'in Express backend'e ulaştığı temel URL ("/api" ile biter).
#   Yerel geliştirme:  http://localhost:3000/api
#   Prod (docker "edge" ağı):  http://bitir-yemek-app:3000/api
BACKEND_API_URL=http://localhost:3000/api

# ── Tarayıcıya açık (NEXT_PUBLIC_*) ────────────────────────────────────────────
# Mapbox erişim token'ı (işletme konum seçici haritası).
# Boş bırakılırsa harita yerine elle enlem/boylam girişi gösterilir.
NEXT_PUBLIC_MAPBOX_TOKEN=

# İsteğe bağlı sabit web origin (CSRF kontrolü). Boşsa Caddy Host ve X-Forwarded-Proto kullanılır.
# WEB_ORIGIN=https://bitirgitsin.com

# TV/telefon ile yerel geliştirme: bilgisayarın LAN IP'si (port/protokol olmadan).
# DEV_ALLOWED_ORIGINS=192.168.1.236

# Teknik TV ekranı: yalnız Next sunucusunda kullanılan SSH bağlantısı.
# Bilinen SSH host anahtarı ve bu projeye erişebilen anahtar gerekir.
# OPS_SSH_HOST=your-vps-address
# OPS_SSH_USER=deploy
# OPS_SSH_KEY=/absolute/path/to/deploy-key
# OPS_SSH_PORT=22
